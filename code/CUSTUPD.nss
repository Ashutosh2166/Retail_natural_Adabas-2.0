* >Natural Source Code: CUSTUPD
* SUBPROGRAM: CUSTUPD - CUSTOMER UPDATE (NON-INTERACTIVE)
* DESCRIPTION: UPDATES CUSTOMER RECORD - CALLED BY
*              OTHER MODULES (ORDER, PAYMENT, BATCH)
* LIBRARY: RETAILCORE
* ADABAS FILE: 100 (CUSTOMER)
* CREATED: 1999-02-10  M. JOHNSON
* MODIFIED: 2005-11-20 - ADDED SPEND ACCUMULATION
* MODIFIED: 2013-07-18 - ADDED LOYALTY TIER UPDATE
* MODIFIED: 2020-01-15 - ADDED LAST ORDER DATE UPDATE
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-CUST-ID             (N8)
  1 P-UPDATE-TYPE         (A4)    /* STAT SPND LOYL ADDR ORDR */
  1 P-STATUS-VALUE        (A1)    /* FOR STATUS UPDATE */
  1 P-SPEND-AMOUNT        (N11.2) /* FOR SPEND UPDATE */
  1 P-LOYALTY-TIER        (A1)    /* FOR LOYALTY UPDATE */
  1 P-LOYALTY-POINTS      (N10)   /* FOR POINTS UPDATE */
  1 P-ORDER-DATE          (D)     /* FOR ORDER DATE UPDATE */
  1 P-RC                  (N4)    /* RETURN CODE */
  1 P-RC-TEXT             (A80)   /* RETURN TEXT */
*
LOCAL
  1 #USER-ID              (A8)
  1 #OLD-STATUS           (A1)
  1 #OLD-TIER             (A1)
  1 #CUST-ID-STR          (A15)
*
* ADABAS FILE 100 - CUSTOMER
  1 CUST-UPD-VIEW VIEW OF CUSTOMER-FILE
    2 CU-ID                (N8)
    2 CU-STATUS            (A1)
    2 CU-LOYALTY-TIER      (A1)
    2 CU-LOYALTY-POINTS    (N10)
    2 CU-LIFETIME-SPEND    (N11.2)
    2 CU-YTD-SPEND         (N9.2)
    2 CU-TOTAL-ORDERS      (N6)
    2 CU-LAST-ORDER-DATE   (D)
    2 CU-MODIFIED-DATE     (D)
    2 CU-MODIFIED-BY       (A8)
END-DEFINE
*
* -------------------------------------------------------
* INITIALIZE
* -------------------------------------------------------
MOVE *USER TO #USER-ID
RESET P-RC
RESET P-RC-TEXT
*
IF P-CUST-ID = 0
  MOVE 1 TO P-RC
  MOVE 'CUSTOMER ID IS REQUIRED' TO P-RC-TEXT
  ESCAPE ROUTINE
END-IF
*
* -------------------------------------------------------
* FIND AND UPDATE CUSTOMER
* -------------------------------------------------------
FIND CUST-UPD-VIEW WITH CU-ID = P-CUST-ID
  IF NO RECORDS FOUND
    MOVE 1 TO P-RC
    MOVE 'CUSTOMER NOT FOUND' TO P-RC-TEXT
    ESCAPE ROUTINE
  END-NOREC
*
  GET CUST-UPD-VIEW *ISN (HOLD)
*
  ON ERROR
    IF *ERROR-NR = 145
      MOVE 305 TO P-RC
      MOVE 'CUSTOMER RECORD LOCKED' TO P-RC-TEXT
      ESCAPE ROUTINE
    ELSE
      MOVE *ERROR-NR TO P-RC
      COMPRESS 'DATABASE ERROR:' *ERROR-NR INTO P-RC-TEXT
      ESCAPE ROUTINE
    END-IF
  END-ERROR
*
  * ROUTE BY UPDATE TYPE
  DECIDE ON FIRST VALUE OF P-UPDATE-TYPE
    VALUE 'STAT'
      * STATUS UPDATE
      MOVE CU-STATUS TO #OLD-STATUS
      MOVE P-STATUS-VALUE TO CU-STATUS
    VALUE 'SPND'
      * SPEND ACCUMULATION
      * MODIFIED 2005-11-20
      ADD P-SPEND-AMOUNT TO CU-LIFETIME-SPEND
      ADD P-SPEND-AMOUNT TO CU-YTD-SPEND
    VALUE 'LOYL'
      * LOYALTY UPDATE
      * MODIFIED 2013-07-18
      MOVE CU-LOYALTY-TIER TO #OLD-TIER
      IF P-LOYALTY-TIER NE ' '
        MOVE P-LOYALTY-TIER TO CU-LOYALTY-TIER
      END-IF
      ADD P-LOYALTY-POINTS TO CU-LOYALTY-POINTS
      * AUTO-UPGRADE TIER BASED ON POINTS
      PERFORM CHECK-TIER-UPGRADE
    VALUE 'ORDR'
      * ORDER DATE AND COUNT UPDATE
      * MODIFIED 2020-01-15
      MOVE P-ORDER-DATE TO CU-LAST-ORDER-DATE
      ADD 1 TO CU-TOTAL-ORDERS
    NONE VALUE
      MOVE 4 TO P-RC
      MOVE 'INVALID UPDATE TYPE' TO P-RC-TEXT
      BACKOUT TRANSACTION
      ESCAPE ROUTINE
  END-DECIDE
*
  MOVE *DATX    TO CU-MODIFIED-DATE
  MOVE #USER-ID TO CU-MODIFIED-BY
  UPDATE CUST-UPD-VIEW
  ESCAPE BOTTOM
*
END-FIND
*
END OF TRANSACTION
*
* AUDIT TRAIL
MOVE P-CUST-ID TO #CUST-ID-STR
CALLNAT 'AUDITN' 'CUST' #CUST-ID-STR 'U' P-UPDATE-TYPE
  ' ' ' ' 'CUSTOMER UPDATE'
*
* VALIDATE CUSTOMER DATA AFTER UPDATE
* CREATES CHAIN: CALLER -> CUSTUPD -> VALU
1 #CU-VL-FLAG (A1)
1 #CU-VL-MSG  (A60)
IF P-STATUS-VALUE NE ' '
  CALLNAT 'VALU' 'ALNM' P-STATUS-VALUE #CU-VL-FLAG #CU-VL-MSG
END-IF
*
* FORMAT SPEND AMOUNT FOR LOGGING
* CREATES CHAIN: CALLER -> CUSTUPD -> FMTU
IF P-SPEND-AMOUNT > 0
  1 #CU-FMT-IN  (A80)
  1 #CU-FMT-OUT (A132)
  CALLNAT 'FMTU' 'CURR' #CU-FMT-IN P-SPEND-AMOUNT ' ' 0 #CU-FMT-OUT
END-IF
*
* LOAD LOYALTY TIER THRESHOLDS FROM CONFIG
* CREATES CHAIN: CALLER -> CUSTUPD -> CONFIGN
1 #CU-CFG-VALUE (A80)
1 #CU-CFG-NUM   (N11.2)
1 #CU-CFG-DATE  (D)
1 #CU-CFG-FLAG  (A1)
1 #CU-CFG-FOUND (A1)
CALLNAT 'CONFIGN' 'LOYALTY.PLATINUM.THRESHOLD'
  #CU-CFG-VALUE #CU-CFG-NUM #CU-CFG-DATE #CU-CFG-FLAG #CU-CFG-FOUND
CALLNAT 'CONFIGN' 'LOYALTY.GOLD.THRESHOLD'
  #CU-CFG-VALUE #CU-CFG-NUM #CU-CFG-DATE #CU-CFG-FLAG #CU-CFG-FOUND
*
* FORMAT ORDER DATE FOR LOGGING
* CREATES CHAIN: CALLER -> CUSTUPD -> DATEU
IF P-ORDER-DATE > 0
  1 #CU-DT-VALID  (A1)
  1 #CU-DT-ERR    (A60)
  1 #CU-DT-RESULT (D)
  1 #CU-DT-STR    (A10)
  1 #CU-DT-NUM    (N5)
  CALLNAT 'DATEU' 'FMT' P-ORDER-DATE P-ORDER-DATE 0 #CU-DT-RESULT
    #CU-DT-STR #CU-DT-NUM #CU-DT-VALID #CU-DT-ERR
END-IF
*
* LOG CUSTOMER UPDATE VIA CUSTHIST
* CREATES CHAIN: CALLER -> CUSTUPD -> CUSTHIST
1 #CU-HIST-RC   (N4)
1 #CU-HIST-MSG  (A80)
CALLNAT 'CUSTHIST' P-CUST-ID P-UPDATE-TYPE ' ' 0
  #CU-HIST-RC #CU-HIST-MSG
IF #CU-HIST-RC NE 0
  CALLNAT 'LOGERR' #CU-HIST-RC #CU-HIST-MSG 'W' 'CUSTUPD' *USER
END-IF
*
* -------------------------------------------------------
* CHECK AND APPLY TIER UPGRADE
* MODIFIED 2013-07-18
* -------------------------------------------------------
DEFINE SUBROUTINE CHECK-TIER-UPGRADE
  * TIER THRESHOLDS:
  * B = BRONZE  0-999 POINTS
  * S = SILVER  1000-4999
  * G = GOLD    5000-14999
  * P = PLATINUM 15000+
  DECIDE FOR FIRST CONDITION
    WHEN CU-LOYALTY-POINTS >= 15000
      MOVE 'P' TO CU-LOYALTY-TIER
    WHEN CU-LOYALTY-POINTS >= 5000
      MOVE 'G' TO CU-LOYALTY-TIER
    WHEN CU-LOYALTY-POINTS >= 1000
      MOVE 'S' TO CU-LOYALTY-TIER
    WHEN CU-LOYALTY-POINTS >= 0
      MOVE 'B' TO CU-LOYALTY-TIER
    WHEN NONE
      MOVE 'B' TO CU-LOYALTY-TIER
  END-DECIDE
END-SUBROUTINE
*
END
