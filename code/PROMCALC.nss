* >Natural Source Code: PROMCALC
* SUBPROGRAM: PROMCALC - PROMOTION PRICE CALCULATOR
* DESCRIPTION: FINDS AND APPLIES ACTIVE PROMOTIONS
*              SUPPORTS PCT/AMT/BOGO/FIXED/QTY DISCOUNT
*              HANDLES STACKABLE PROMOTIONS
* LIBRARY: RETAILCORE
* ADABAS FILE: 121 (PROMOTION), 122 (PROMOTION-ITEM)
* CREATED: 2007-05-15  S. MARTINEZ
* MODIFIED: 2011-09-22 - ADDED STACKABLE LOGIC
* MODIFIED: 2016-03-10 - ADDED COUPON INTEGRATION
* MODIFIED: 2020-12-15 - ADDED EXCLUSION LIST
* MODIFIED: 2024-01-10 - ADDED TIER-BASED DISCOUNTS
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-PROD-ID             (N8)
  1 P-SKU                 (A15)
  1 P-STORE-ID            (N4)
  1 P-CUST-ID             (N8)
  1 P-QTY                 (N6)
  1 P-CURRENT-PRICE       (N9.2)
  1 P-PROMO-PRICE         (N9.2)
  1 P-PROMO-APPLIED       (A1)
  1 P-VALID-FLAG          (A1)
  1 P-ERROR-MSG           (A60)
*
LOCAL
  1 #TODAY                (D)
  1 #BEST-PRICE           (N9.2)
  1 #CALC-PRICE           (N9.2)
  1 #DISCOUNT-AMT         (N9.2)
  1 #TOTAL-DISCOUNT       (N9.2)
  1 #PROMO-FOUND          (A1)
  1 #ELIGIBLE             (A1)
  1 #EXCLUDED             (A1)
  1 #PROMO-COUNT          (N3)
  1 #MAX-STACK            (N2)     INIT <3>
  1 #STACK-COUNT          (N2)
*
* ACTIVE PROMOTION TRACKING (UP TO 10)
  1 #ACTIVE-PROMOS (10)
    2 #AP-ID              (N8)
    2 #AP-TYPE            (A2)
    2 #AP-VALUE           (N9.2)
    2 #AP-MIN-QTY         (N6)
    2 #AP-MIN-AMT         (N9.2)
    2 #AP-STACKABLE       (A1)
    2 #AP-PRIORITY        (N2)
    2 #AP-DISC-AMT        (N9.2)
*
  1 PM-VIEW VIEW OF PROMOTION-FILE
    2 PM-ID                (N8)
    2 PM-NAME              (A40)
    2 PM-TYPE              (A2)
    2 PM-VALUE             (N9.2)
    2 PM-MIN-QTY           (N6)
    2 PM-MIN-ORDER-AMT     (N9.2)
    2 PM-START-DATE        (D)
    2 PM-END-DATE          (D)
    2 PM-STATUS            (A1)
    2 PM-STACKABLE         (A1)
    2 PM-PRIORITY          (N2)
    2 PM-STORE-ID          (N4)
    2 PM-MAX-USES          (N6)
    2 PM-CURRENT-USES      (N6)
*
  1 PI-VIEW VIEW OF PROMO-ITEM-FILE
    2 PI-PROMO-ID          (N8)
    2 PI-PROD-ID           (N8)
    2 PI-SKU               (A15)
    2 PI-CATEGORY          (A10)
    2 PI-INCLUDE-FLAG      (A1)    /* Y=INCLUDE N=EXCLUDE */
END-DEFINE
*
MOVE *DATX TO #TODAY
MOVE 'Y' TO P-VALID-FLAG
RESET P-ERROR-MSG
MOVE 'N' TO P-PROMO-APPLIED
MOVE P-CURRENT-PRICE TO P-PROMO-PRICE
MOVE P-CURRENT-PRICE TO #BEST-PRICE
RESET #PROMO-COUNT
RESET #STACK-COUNT
RESET #TOTAL-DISCOUNT
*
* -------------------------------------------------------
* STEP 1: FIND ALL ACTIVE PROMOTIONS
* -------------------------------------------------------
READ PM-VIEW BY PM-START-DATE
  IF PM-END-DATE < #TODAY
    ESCAPE TOP
  END-IF
  IF PM-START-DATE > #TODAY
    ESCAPE BOTTOM
  END-IF
  IF PM-STATUS NE 'A'
    ESCAPE TOP
  END-IF
*
  * CHECK STORE RESTRICTION
  IF PM-STORE-ID > 0 AND PM-STORE-ID NE P-STORE-ID
    ESCAPE TOP
  END-IF
*
  * CHECK MAX USES
  IF PM-MAX-USES > 0 AND PM-CURRENT-USES >= PM-MAX-USES
    ESCAPE TOP
  END-IF
*
  * CHECK PRODUCT ELIGIBILITY
  MOVE 'N' TO #ELIGIBLE
  MOVE 'N' TO #EXCLUDED
  FIND PI-VIEW WITH PI-PROMO-ID = PM-ID
    IF NO RECORDS FOUND
      * NO ITEM RESTRICTIONS - ELIGIBLE FOR ALL
      MOVE 'Y' TO #ELIGIBLE
      ESCAPE ROUTINE
    END-NOREC
    IF PI-INCLUDE-FLAG = 'N'
      * EXCLUSION ENTRY
      IF PI-PROD-ID = P-PROD-ID OR PI-SKU = P-SKU
        MOVE 'Y' TO #EXCLUDED
      END-IF
    ELSE
      * INCLUSION ENTRY
      IF PI-PROD-ID = P-PROD-ID OR PI-SKU = P-SKU
        MOVE 'Y' TO #ELIGIBLE
      END-IF
    END-IF
  END-FIND
*
  IF #EXCLUDED = 'Y'
    ESCAPE TOP
  END-IF
*
  * IF NO INCLUSIONS FOUND BUT NO EXCLUSIONS EITHER
  * ASSUME ELIGIBLE (OPEN PROMOTION)
  * THIS IS LEGACY BEHAVIOR - SHOULD BE MORE RESTRICTIVE
*
  * CHECK MINIMUM QUANTITY
  IF PM-MIN-QTY > 0 AND P-QTY < PM-MIN-QTY
    ESCAPE TOP
  END-IF
*
  * CHECK MINIMUM ORDER AMOUNT
  IF PM-MIN-ORDER-AMT > 0
    IF (P-CURRENT-PRICE * P-QTY) < PM-MIN-ORDER-AMT
      ESCAPE TOP
    END-IF
  END-IF
*
  * ADD TO ACTIVE PROMOS LIST
  ADD 1 TO #PROMO-COUNT
  IF #PROMO-COUNT > 10
    ESCAPE BOTTOM
  END-IF
  MOVE PM-ID          TO #ACTIVE-PROMOS.#AP-ID(#PROMO-COUNT)
  MOVE PM-TYPE        TO #ACTIVE-PROMOS.#AP-TYPE(#PROMO-COUNT)
  MOVE PM-VALUE       TO #ACTIVE-PROMOS.#AP-VALUE(#PROMO-COUNT)
  MOVE PM-MIN-QTY     TO #ACTIVE-PROMOS.#AP-MIN-QTY(#PROMO-COUNT)
  MOVE PM-MIN-ORDER-AMT TO #ACTIVE-PROMOS.#AP-MIN-AMT(#PROMO-COUNT)
  MOVE PM-STACKABLE   TO #ACTIVE-PROMOS.#AP-STACKABLE(#PROMO-COUNT)
  MOVE PM-PRIORITY    TO #ACTIVE-PROMOS.#AP-PRIORITY(#PROMO-COUNT)
*
END-READ
*
IF #PROMO-COUNT = 0
  * NO PROMOTIONS FOUND - USE CURRENT PRICE
  ESCAPE ROUTINE
END-IF
*
* -------------------------------------------------------
* STEP 2: CALCULATE DISCOUNT FOR EACH PROMOTION
* -------------------------------------------------------
1 #PI (N3)
FOR #PI = 1 TO #PROMO-COUNT
  RESET #DISCOUNT-AMT
  DECIDE ON FIRST VALUE OF #ACTIVE-PROMOS.#AP-TYPE(#PI)
    VALUE 'PC'
      * PERCENTAGE DISCOUNT
      COMPUTE #DISCOUNT-AMT = P-CURRENT-PRICE
        * (#ACTIVE-PROMOS.#AP-VALUE(#PI) / 100)
    VALUE 'AM'
      * FIXED AMOUNT OFF
      MOVE #ACTIVE-PROMOS.#AP-VALUE(#PI) TO #DISCOUNT-AMT
    VALUE 'BG'
      * BUY ONE GET ONE (SIMPLIFIED)
      IF P-QTY >= 2
        COMPUTE #DISCOUNT-AMT = P-CURRENT-PRICE
          * (P-QTY / 2)
        * ONLY DISCOUNT HALF THE ITEMS
        COMPUTE #DISCOUNT-AMT = #DISCOUNT-AMT / P-QTY
      END-IF
    VALUE 'FX'
      * FIXED PRICE
      IF #ACTIVE-PROMOS.#AP-VALUE(#PI) < P-CURRENT-PRICE
        COMPUTE #DISCOUNT-AMT = P-CURRENT-PRICE
          - #ACTIVE-PROMOS.#AP-VALUE(#PI)
      END-IF
    VALUE 'QD'
      * QUANTITY DISCOUNT
      IF P-QTY >= #ACTIVE-PROMOS.#AP-MIN-QTY(#PI)
        COMPUTE #DISCOUNT-AMT = P-CURRENT-PRICE
          * (#ACTIVE-PROMOS.#AP-VALUE(#PI) / 100)
      END-IF
    NONE VALUE
      IGNORE
  END-DECIDE
  MOVE #DISCOUNT-AMT TO #ACTIVE-PROMOS.#AP-DISC-AMT(#PI)
END-FOR
*
* -------------------------------------------------------
* STEP 3: APPLY BEST NON-STACKABLE OR STACK ELIGIBLE
* -------------------------------------------------------
* FIRST: FIND BEST NON-STACKABLE
1 #PJ (N3)
1 #BEST-DISC (N9.2)
1 #BEST-IDX (N3)
RESET #BEST-DISC
RESET #BEST-IDX
FOR #PJ = 1 TO #PROMO-COUNT
  IF #ACTIVE-PROMOS.#AP-STACKABLE(#PJ) NE 'Y'
    IF #ACTIVE-PROMOS.#AP-DISC-AMT(#PJ) > #BEST-DISC
      MOVE #ACTIVE-PROMOS.#AP-DISC-AMT(#PJ) TO #BEST-DISC
      MOVE #PJ TO #BEST-IDX
    END-IF
  END-IF
END-FOR
*
IF #BEST-IDX > 0
  MOVE #BEST-DISC TO #TOTAL-DISCOUNT
END-IF
*
* THEN: ADD STACKABLE DISCOUNTS (UP TO MAX)
1 #PK (N3)
FOR #PK = 1 TO #PROMO-COUNT
  IF #ACTIVE-PROMOS.#AP-STACKABLE(#PK) = 'Y'
    IF #STACK-COUNT < #MAX-STACK
      ADD #ACTIVE-PROMOS.#AP-DISC-AMT(#PK) TO #TOTAL-DISCOUNT
      ADD 1 TO #STACK-COUNT
    END-IF
  END-IF
END-FOR
*
* -------------------------------------------------------
* STEP 4: APPLY FINAL DISCOUNT
* -------------------------------------------------------
IF #TOTAL-DISCOUNT > 0
  COMPUTE P-PROMO-PRICE = P-CURRENT-PRICE - #TOTAL-DISCOUNT
  IF P-PROMO-PRICE < 0
    MOVE 0.01 TO P-PROMO-PRICE
  END-IF
  MOVE 'Y' TO P-PROMO-APPLIED
END-IF
*
* -------------------------------------------------------
* VALIDATE PRODUCT IS ACTIVE VIA PRODGET
* CREATES CHAIN: CALLER -> PROMCALC -> PRODGET -> DATEU/CONFIGN
* -------------------------------------------------------
IF P-PROMO-APPLIED = 'Y' AND P-PROD-ID > 0
  1 #PC-PG-PROD-ID (N8)
  1 #PC-PG-SKU     (A15)
  1 #PC-PG-DATA
    2 #PC-PD-ID    (N8)
    2 #PC-PD-SKU   (A15)
    2 #PC-PD-ITEM  (A12)
    2 #PC-PD-NAME  (A60)
    2 #PC-PD-SHORT (A30)
    2 #PC-PD-LONG  (A200)
    2 #PC-PD-STAT  (A1)
    2 #PC-PD-TYPE  (A2)
    2 #PC-PD-BRAND (A30)
    2 #PC-PD-MFGR  (A40)
    2 #PC-PD-UPC   (A13)
  1 #PC-PG-CAT
    2 #PC-PC-DEPT  (A4)
    2 #PC-PC-CLS   (A4)
    2 #PC-PC-SUB   (A4)
    2 #PC-PC-PATH  (A60)
  1 #PC-PG-ATTR
    2 #PC-PA-COLOR (A20)
    2 #PC-PA-SIZE  (A10)
    2 #PC-PA-WGHT  (N7.3)
    2 #PC-PA-PRSH  (A1)
    2 #PC-PA-HAZD  (A1)
    2 #PC-PA-SEAS  (A1)
  1 #PC-PG-PRICE
    2 #PC-PP-COST  (N9.2)
    2 #PC-PP-PRICE (N9.2)
    2 #PC-PP-MSRP  (N9.2)
    2 #PC-PP-MIN   (N9.2)
    2 #PC-PP-TAX   (A4)
    2 #PC-PP-CURR  (A3)
  1 #PC-PG-LIFE
    2 #PC-PL-INT   (D)
    2 #PC-PL-DIS   (D)
    2 #PC-PL-CLR   (D)
    2 #PC-PL-LAST  (D)
  1 #PC-PG-FOUND (A1)
  1 #PC-PG-ERR   (A60)
  MOVE P-PROD-ID TO #PC-PG-PROD-ID
  MOVE P-SKU TO #PC-PG-SKU
  CALLNAT 'PRODGET' #PC-PG-PROD-ID #PC-PG-SKU #PC-PG-DATA #PC-PG-CAT
    #PC-PG-ATTR #PC-PG-PRICE #PC-PG-LIFE #PC-PG-FOUND #PC-PG-ERR
  IF #PC-PG-FOUND = 'Y'
    IF #PC-PD-STAT = 'D'
      MOVE 'N' TO P-PROMO-APPLIED
      MOVE P-CURRENT-PRICE TO P-PROMO-PRICE
      MOVE 'PROMO REVOKED - PRODUCT DISCONTINUED' TO P-ERROR-MSG
    END-IF
    * ENFORCE MIN PRICE FROM PRODUCT MASTER
    IF #PC-PP-MIN > 0 AND P-PROMO-PRICE < #PC-PP-MIN
      MOVE #PC-PP-MIN TO P-PROMO-PRICE
    END-IF
  END-IF
END-IF
*
* CHECK CUSTOMER LOYALTY TIER FOR ADDITIONAL DISCOUNT
* CREATES CHAIN: CALLER -> PROMCALC -> CUSTGET -> LOGERR
IF P-CUST-ID > 0 AND P-PROMO-APPLIED = 'Y'
  1 #PC-CG-DATA
    2 #PC-CG-ID    (N8)
    2 #PC-CG-NO    (A10)
    2 #PC-CG-TYPE  (A2)
    2 #PC-CG-STAT  (A1)
    2 #PC-CG-TITLE (A5)
    2 #PC-CG-FNAME (A30)
    2 #PC-CG-LNAME (A40)
    2 #PC-CG-DOB   (D)
    2 #PC-CG-GEND  (A1)
  1 #PC-CG-CONTACT
    2 #PC-CG-EMAIL (A80)
    2 #PC-CG-PH    (A20)
    2 #PC-CG-MOB   (A20)
    2 #PC-CG-WPH   (A20)
  1 #PC-CG-ADDR
    2 #PC-CG-ADDR1 (A40)
    2 #PC-CG-ADDR2 (A40)
    2 #PC-CG-CITY  (A30)
    2 #PC-CG-STATE (A2)
    2 #PC-CG-ZIP   (A10)
    2 #PC-CG-CTRY  (A3)
  1 #PC-CG-MEMBER
    2 #PC-CG-MFLAG (A1)
    2 #PC-CG-MID   (A12)
    2 #PC-CG-MSINCE (D)
    2 #PC-CG-LTIER (A1)
    2 #PC-CG-LPTS  (N10)
    2 #PC-CG-LSPND (N11.2)
    2 #PC-CG-YTDSP (N9.2)
  1 #PC-CG-FOUND  (A1)
  1 #PC-CG-ERR    (A60)
  CALLNAT 'CUSTGET' P-CUST-ID #PC-CG-DATA #PC-CG-CONTACT #PC-CG-ADDR
    #PC-CG-MEMBER #PC-CG-FOUND #PC-CG-ERR
  IF #PC-CG-FOUND = 'Y' AND #PC-CG-MFLAG = 'Y'
    * PLATINUM AND GOLD MEMBERS GET EXTRA 2% ON PROMOS
    IF #PC-CG-LTIER = 'P' OR #PC-CG-LTIER = 'G'
      1 #PC-LOYALTY-DISC (N9.2)
      COMPUTE #PC-LOYALTY-DISC = P-PROMO-PRICE * 0.02
      SUBTRACT #PC-LOYALTY-DISC FROM P-PROMO-PRICE
      IF P-PROMO-PRICE < 0.01
        MOVE 0.01 TO P-PROMO-PRICE
      END-IF
    END-IF
  END-IF
END-IF
*
* LOAD MAX DISCOUNT CONFIGURATION
* CREATES CHAIN: CALLER -> PROMCALC -> CONFIGN
1 #PC-CFG-VALUE (A80)
1 #PC-CFG-NUM   (N11.2)
1 #PC-CFG-DATE  (D)
1 #PC-CFG-FLAG  (A1)
1 #PC-CFG-FOUND (A1)
1 #PC-MAX-DISC-PCT (N5.2) INIT <50>
CALLNAT 'CONFIGN' 'PROMO.MAX.DISCOUNT.PCT'
  #PC-CFG-VALUE #PC-CFG-NUM #PC-CFG-DATE #PC-CFG-FLAG #PC-CFG-FOUND
IF #PC-CFG-FOUND = 'Y'
  MOVE #PC-CFG-NUM TO #PC-MAX-DISC-PCT
END-IF
*
* ENFORCE MAX DISCOUNT LIMIT
IF P-PROMO-APPLIED = 'Y' AND P-CURRENT-PRICE > 0
  1 #PC-DISC-PCT (N5.2)
  COMPUTE #PC-DISC-PCT = ((P-CURRENT-PRICE - P-PROMO-PRICE)
    / P-CURRENT-PRICE) * 100
  IF #PC-DISC-PCT > #PC-MAX-DISC-PCT
    * CAP AT MAX DISCOUNT
    COMPUTE P-PROMO-PRICE = P-CURRENT-PRICE
      * (1 - #PC-MAX-DISC-PCT / 100)
    CALLNAT 'LOGERR' 650 'PROMO DISCOUNT CAPPED AT MAX THRESHOLD'
      'W' 'PROMCALC' *USER
  END-IF
END-IF
*
* VALIDATE SKU IF PROVIDED
* CREATES CHAIN: CALLER -> PROMCALC -> SKUVAL -> LOGERR
IF P-SKU NE ' '
  1 #PC-SK-PROD-ID (N8)
  1 #PC-SK-NAME    (A60)
  1 #PC-SK-STATUS  (A1)
  1 #PC-SK-PRICE   (N9.2)
  1 #PC-SK-TAX     (A4)
  1 #PC-SK-VALID   (A1)
  1 #PC-SK-MSG     (A60)
  CALLNAT 'SKUVAL' P-SKU ' ' #PC-SK-PROD-ID #PC-SK-NAME
    #PC-SK-STATUS #PC-SK-PRICE #PC-SK-TAX #PC-SK-VALID #PC-SK-MSG
  IF #PC-SK-VALID NE 'Y'
    MOVE 'N' TO P-VALID-FLAG
    MOVE #PC-SK-MSG TO P-ERROR-MSG
  END-IF
END-IF
*
END
