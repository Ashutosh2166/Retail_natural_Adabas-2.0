* >Natural Source Code: SKUVAL
* SUBPROGRAM: SKUVAL - SKU VALIDATION
* DESCRIPTION: VALIDATES SKU AND RETURNS PRODUCT INFO
*              USED BY ORDER ENTRY AND INVENTORY
* LIBRARY: RETAILCORE
* ADABAS FILE: 101 (PRODUCT)
* CREATED: 1999-04-10  T. ANDERSON
* MODIFIED: 2005-08-18 - ADDED ARTICLE-NO LOOKUP
* MODIFIED: 2013-12-05 - ADDED STATUS CHECK
* MODIFIED: 2020-06-15 - ADDED DISCONTINUED CHECK
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-SKU                 (A15)
  1 P-ITEM-NO             (A12)   /* LEGACY ITEM NUMBER ALTERNATE */
  1 P-PROD-ID             (N8)    /* RETURNED PRODUCT ID */
  1 P-PROD-NAME           (A60)   /* RETURNED NAME */
  1 P-PROD-STATUS         (A1)    /* RETURNED STATUS */
  1 P-BASE-PRICE          (N9.2)  /* RETURNED PRICE */
  1 P-TAX-CODE            (A4)    /* RETURNED TAX CODE */
  1 P-VALID-FLAG          (A1)    /* Y=VALID AND ACTIVE */
  1 P-ERROR-MSG           (A60)
*
LOCAL
  1 SKU-VIEW VIEW OF PRODUCT-FILE
    2 PR-ID                (N8)
    2 PR-SKU               (A15)
    2 PR-ITEM-NO           (A12)
    2 PR-ARTICLE-NO        (A10)
    2 PR-NAME              (A60)
    2 PR-STATUS            (A1)
    2 PR-BASE-PRICE        (N9.2)
    2 PR-TAX-CODE          (A4)
    2 PR-DISCO-DATE        (D)
END-DEFINE
*
MOVE 'N' TO P-VALID-FLAG
RESET P-ERROR-MSG
RESET P-PROD-ID
*
* TRY SKU FIRST, THEN ITEM-NO (LEGACY COMPATIBILITY)
* MODIFIED 2005-08-18
IF P-SKU NE ' '
  FIND SKU-VIEW WITH PR-SKU = P-SKU
    IF NO RECORDS FOUND
      MOVE 'SKU NOT FOUND' TO P-ERROR-MSG
      ESCAPE ROUTINE
    END-NOREC
    PERFORM CHECK-PRODUCT
    ESCAPE BOTTOM
  END-FIND
ELSE IF P-ITEM-NO NE ' '
  * LEGACY ITEM NUMBER LOOKUP
  FIND SKU-VIEW WITH PR-ITEM-NO = P-ITEM-NO
    IF NO RECORDS FOUND
      MOVE 'ITEM NUMBER NOT FOUND' TO P-ERROR-MSG
      ESCAPE ROUTINE
    END-NOREC
    PERFORM CHECK-PRODUCT
    ESCAPE BOTTOM
  END-FIND
ELSE
  MOVE 'SKU OR ITEM NUMBER REQUIRED' TO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
END-IF
*
ON ERROR
  COMPRESS 'DATABASE ERROR IN SKUVAL:' *ERROR-NR INTO P-ERROR-MSG
  CALLNAT 'LOGERR' 103 P-ERROR-MSG 'E' 'SKUVAL' *USER
END-ERROR
*
DEFINE SUBROUTINE CHECK-PRODUCT
  MOVE PR-ID         TO P-PROD-ID
  MOVE PR-NAME       TO P-PROD-NAME
  MOVE PR-STATUS     TO P-PROD-STATUS
  MOVE PR-BASE-PRICE TO P-BASE-PRICE
  MOVE PR-TAX-CODE   TO P-TAX-CODE
*
  * CHECK STATUS
  IF PR-STATUS = 'D'
    MOVE 'N' TO P-VALID-FLAG
    MOVE 'PRODUCT IS DISCONTINUED' TO P-ERROR-MSG
    ESCAPE ROUTINE
  END-IF
  IF PR-STATUS = 'I'
    MOVE 'N' TO P-VALID-FLAG
    MOVE 'PRODUCT IS INACTIVE' TO P-ERROR-MSG
    ESCAPE ROUTINE
  END-IF
  IF PR-STATUS NE 'A' AND PR-STATUS NE 'C'
    MOVE 'N' TO P-VALID-FLAG
    COMPRESS 'PRODUCT STATUS INVALID:' PR-STATUS INTO P-ERROR-MSG
    ESCAPE ROUTINE
  END-IF
*
  * VALIDATE SKU FORMAT VIA VALU
  * CREATES CHAIN: CALLER -> SKUVAL -> VALU
  1 #SK-VL-FLAG (A1)
  1 #SK-VL-MSG  (A60)
  CALLNAT 'VALU' 'ALNM' P-SKU #SK-VL-FLAG #SK-VL-MSG
  IF #SK-VL-FLAG NE 'Y'
    MOVE 'N' TO P-VALID-FLAG
    MOVE 'SKU FORMAT CONTAINS INVALID CHARACTERS' TO P-ERROR-MSG
    ESCAPE ROUTINE
  END-IF
*
  * CHECK DISCONTINUATION DATE VIA DATEU
  * CREATES CHAIN: CALLER -> SKUVAL -> DATEU
  IF PR-DISCO-DATE > 0
    1 #SK-DT-VALID  (A1)
    1 #SK-DT-ERR    (A60)
    1 #SK-DT-RESULT (D)
    1 #SK-DT-STR    (A10)
    1 #SK-DT-NUM    (N5)
    CALLNAT 'DATEU' 'DIFF' *DATX PR-DISCO-DATE 0 #SK-DT-RESULT
      #SK-DT-STR #SK-DT-NUM #SK-DT-VALID #SK-DT-ERR
    * IF DISCO DATE IS IN THE PAST, PRODUCT SHOULD BE DISCONTINUED
    IF #SK-DT-VALID = 'Y' AND #SK-DT-NUM < 0
      MOVE 'N' TO P-VALID-FLAG
      MOVE 'PRODUCT DISCONTINUATION DATE HAS PASSED' TO P-ERROR-MSG
      ESCAPE ROUTINE
    END-IF
  END-IF
*
  * LOAD TAX RATE CONFIG FOR VALIDATION
  * CREATES CHAIN: CALLER -> SKUVAL -> CONFIGN
  IF PR-TAX-CODE NE ' '
    1 #SK-CFG-VALUE (A80)
    1 #SK-CFG-NUM   (N11.2)
    1 #SK-CFG-DATE  (D)
    1 #SK-CFG-FLAG  (A1)
    1 #SK-CFG-FOUND (A1)
    1 #SK-TAX-KEY   (A30)
    COMPRESS 'TAX.RATE.' PR-TAX-CODE INTO #SK-TAX-KEY
      LEAVING NO SPACE
    CALLNAT 'CONFIGN' #SK-TAX-KEY
      #SK-CFG-VALUE #SK-CFG-NUM #SK-CFG-DATE #SK-CFG-FLAG #SK-CFG-FOUND
    IF #SK-CFG-FOUND NE 'Y'
      CALLNAT 'LOGERR' 104 'TAX CODE NOT FOUND IN CONFIG'
        'W' 'SKUVAL' *USER
    END-IF
  END-IF
*
  MOVE 'Y' TO P-VALID-FLAG
END-SUBROUTINE
*
END
